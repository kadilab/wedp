# Environnement
NODE_ENV=development
PORT=5000

# Base de données MySQL
DATABASE_URL="mysql://root:password@localhost:3306/wedding_invite"

# JWT
JWT_SECRET=votre_secret_jwt_tres_long_et_securise
JWT_EXPIRES_IN=7d

# Frontend URL (CORS)
FRONTEND_URL=http://localhost:3000

# SMTP (Email)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=votre@email.com
SMTP_PASS=votre_mot_de_passe_app
EMAIL_FROM=noreply@weddinginvite.pro

# K-PAY (Mobile Money) — https://kpay.site/documentation
KPAY_BASE_URL=https://admin.kpay.site
KPAY_API_KEY=
KPAY_SECRET_KEY=
KPAY_WEBHOOK_SECRET=
# Clés sandbox (kpay_test_) — basculer TEST/PRODUCTION depuis Admin → Paramètres → Paiement
KPAY_TEST_API_KEY=
KPAY_TEST_SECRET_KEY=
KPAY_TEST_WEBHOOK_SECRET=
# TEST | LIVE (par défaut : déduit du préfixe de KPAY_API_KEY)
KPAY_MODE=
# Signature du retour de la page hébergée (par défaut : le secret webhook)
KPAY_GATEWAY_SECRET=
# Paiement par carte Visa/Mastercard (USD) — false tant qu'un vrai paiement n'a pas été testé
KPAY_CARD_ENABLED=false
# Opérateurs désactivés manuellement, séparés par des virgules (ex : AIRTEL_COD)
KPAY_DISABLED_PROVIDERS=
